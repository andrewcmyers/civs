my @errors = ();

# The questions the poll asks. Question 0 posts the unprefixed field names
# that single-question polls have always posted, and question N posts the
# same names prefixed "qN_". They arrive dense and in the order the
# supervisor arranged them on the page.
my $num_questions = natParam('num_questions');
if (!$num_questions || $num_questions < 1) { $num_questions = 1 }
if ($num_questions > @MAX_QUESTIONS@) {
    push @errors, li($tx->Poll_exceeds_max_questions(@MAX_QUESTIONS@));
    $num_questions = @MAX_QUESTIONS@;
}

# The name under which question $q posts the field $field.
sub QuestionField {
    my ($q, $field) = @_;
    return ($q == 0) ? $field : "q${q}_$field";
}

# The choices offered by one question, taken from its text area and from
# its uploaded file if it has one, trimmed and filtered. Returns the
# newline-separated list and how many choices are in it.
sub ReadChoices {
    my ($q) = @_;
    my $text = param(QuestionField($q, 'choices'));
    my @split = split /(\r\n)+/, (defined($text) ? $text : '');
    my $file = upload(QuestionField($q, 'choices_file'));
    if (defined($file) && VerifyUpload($file, \@errors, "file of choices")) {
        local $/ = "\n";
        while (<$file>) {
            chomp;
            push @split, $_;
        }
    }
    my $choices = '';
    my $count = 0;
    foreach my $ch (@split) {
        $ch = Filter(TrimChoice($ch));
        if (defined($ch) && !($ch =~ m/^\s*$/)) {
            $choices .= $ch . "\n";
            $count++;
        }
    }
    return ($choices, $count);
}

sub TrimChoice {
    (my $s) = @_;
    $s =~ s/^\s+//;
    $s =~ s/\s+$//;
    return $s;
}

my @question_data;
for (my $q = 0; $q < $num_questions; $q++) {
    # Only say which question when the poll asks more than one.
    my $where = ($num_questions > 1) ? $tx->Question_number($q + 1) . ': ' : '';
    my ($choices, $num_choices) = ReadChoices($q);
    if ($num_choices < 2) {
        push @errors, li($where . $tx->Poll_must_have_two_choices);
    }
    if ($num_choices > @MAX_CHOICES@) {
        push @errors, li($where . $tx->Poll_exceeds_max_choices(@MAX_CHOICES@));
    }
    my $question_title = Filter(scalar param(QuestionField($q, 'question_title')) || '');
    if ($num_questions > 1 && $question_title =~ m/^\s*$/) {
        push @errors, li($where . $tx->Each_question_needs_text);
    }
    my $num_winners = natParam(QuestionField($q, 'num_winners'));
    if (!$num_winners || $num_winners < 1) {
        push @errors, li($where . $tx->Must_have_at_least_one_winner);
    }
    # Proportional representation is settled question by question, along
    # with the reading it gives a voter's ratings, which means nothing
    # without it.
    # Only the checkbox's own value counts: an explicit "no" arrives as a
    # non-empty string and must not be read as a yes.
    my $prop = param(QuestionField($q, 'proportional')) || 'no';
    $prop = 'no' unless $prop eq 'yes';
    my $rating = param(QuestionField($q, 'rating_interpretation'));
    my $combined = (defined($rating) && $rating eq 'combined_ratings') ? 1 : 0;
    if ($prop eq 'yes' && $num_winners == 1) {
        push @errors, li($where
            . $tx->Proportional_representation_requires_more_than_one_winner);
    }
    push @question_data, { choices        => encode('utf-8', $choices),
                           question_title => encode('utf-8', $question_title),
                           num_winners    => $num_winners,
                           proportional   => $prop,
                           use_combined_ratings => $combined };
}

if ($#errors >= 0) {
    print h1($tx->Error);
    print ul(@errors);
    print end_html();
    exit 0;
}

### Election looks ok, create the election directory

